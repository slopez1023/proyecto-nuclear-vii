# Copia este archivo a backend/.env (NO se versiona) y completa los valores.
# Clave de YouTube Data API v3 (Google Cloud Console). Nunca la pongas en la app Android ni en Git.
YOUTUBE_API_KEY=
PORT=3000
# URL pública HTTPS base que codifica el QR (ej. https://nuclear.example.com). En local: http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
# Android App Links: paquete y huella SHA-256 del certificado de firma (para /.well-known/assetlinks.json)
ANDROID_PACKAGE=co.edu.cue.nuclear.cliente
ANDROID_SHA256_CERT=

# --- Entregable 4 ---------------------------------------------------------------------------------
# El backend del E4 necesita PostgreSQL: sin DATABASE_URL el arranque falla (a propósito). Para ejecutar SOLO lo del E3
# (acceso por QR, búsqueda y eventos, sin base de datos) hay que pedirlo de forma explícita con E4_HABILITADO=false.
# Cualquier otro valor que no sea true/false es un error. Por defecto (vacío) = true.
E4_HABILITADO=true
# PostgreSQL 16. Con `npm run db:up` (docker-compose.yml) los valores de abajo funcionan tal cual
# (usuario/contraseña SOLO de desarrollo local). En despliegue, DATABASE_URL viene de un secreto.
DATABASE_URL=postgres://ponga:ponga@localhost:5433/ponga
# Base para `npm test`: cada archivo de prueba crea y borra su propio schema dentro de ella.
DATABASE_URL_TEST=postgres://ponga:ponga@localhost:5433/ponga_test
# Token que exigen los endpoints del reproductor (POST …/reproduccion/iniciar y …/siguiente) en la
# cabecera X-Reproductor-Token. Vacío = esos endpoints responden 404. NO es la autenticación del E5.
REPRODUCTOR_TOKEN=
# true = habilita /api/simulacion/* (modo automático y dispositivos activos virtuales) y marca las
# reproducciones reportadas como origen 'simulacion'. Nunca en producción.
SIMULACION_HABILITADA=false
# true = carga data/catalogo.semilla.json en la tabla cancion al arrancar (demos sin gastar cuota).
CATALOGO_SEMILLA=false
